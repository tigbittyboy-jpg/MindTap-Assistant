{
  "manifest_version": 3,
  "name": "MindTap Study Assistant",
  "version": "0.5.5.5",
  "description": "Review AI suggestions for visible multiple-choice questions in MindTap.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://ebooks.cengage.com/*",
    "https://ng.cengage.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "version_name": "v0.5.5.5",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ebooks.cengage.com/reader/*"
      ],
      "js": [
        "content.js",
        "textbook-watch.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
